class Solution {
    public Node connect(Node root) {

        // Agar tree empty hai to kuch connect nahi karna
        if(root == null)
            return null;

        Queue<Node> q = new LinkedList<>();

        // Root ko queue me daal do
        q.offer(root);

        while(!q.isEmpty())
        {
            // Current level me kitne nodes hain
            int size = q.size();

            // Pure level ke nodes process karenge
            for(int i = 0; i < size; i++)
            {
                // Queue se current node nikalo
                Node curr = q.poll();

                // Agar ye level ka last node nahi hai
                // to iska next queue ke front wale node se connect hoga
                if(i < size - 1)
                {
                    curr.next = q.peek();
                }

                // Left child ko queue me daal do
                if(curr.left != null)
                    q.offer(curr.left);

                // Right child ko queue me daal do
                if(curr.right != null)
                    q.offer(curr.right);
            }
        }

        return root;
    }
}