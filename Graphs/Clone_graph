class Solution {
    // Original node - Cloned node mapping
    HashMap<Node, Node> map = new HashMap<>();
    public Node cloneGraph(Node node) {
        if (node == null)
            return null;
        if (map.containsKey(node))
            return map.get(node);
        //create current node ka clone 
        Node copy = new Node(node.val);
        //store mapping
        map.put(node, copy);
        for (Node neighbour : node.neighbors) {
            copy.neighbors.add(cloneGraph(neighbour)); //clone all neighbours
        }
        return copy;
    }
}