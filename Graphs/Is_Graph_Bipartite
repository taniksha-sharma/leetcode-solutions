class Solution {
    public boolean isBipartite(int[][] graph) {
        int V = graph.length;
        int[] color = new int[V];
        Arrays.fill(color, -1); // -1 = unvisited, 0 & 1 are colors
        //loop for disconnected components
        for (int i = 0; i < V; i++) {
            if (color[i] == -1) {
                if (!checkBFS(i, graph, color)) {
                    return false;
                }
            }
        }
        return true;
    }

    private boolean checkBFS(int start, int[][] graph, int[] color) {
        Queue<Integer> q = new LinkedList<>();
        q.add(start);
        color[start] = 0;

        while (!q.isEmpty()) {
            int node = q.poll();

            for (int neighbor : graph[node]) {
                //agar neighbor visit nahi hua hai
                if (color[neighbor] == -1) {
                    color[neighbor] = 1 - color[node]; // Opposite color assign krddenge
                    q.add(neighbor);
                } 
                //agar neighbor pehle se visited hai aur same color ka hai - Conflict!
                else if (color[neighbor] == color[node]) {
                    return false;
                }
            }
        }
        return true;
    }
}