class Solution {
    public int[] validSequence(String word1, String word2) {
        int n = word1.length();
        int m = word2.length();
        int[] right = new int[m];
        int p = n - 1;
        for (int i = m - 1; i >= 0; i--) {
            while (p >= 0 && word1.charAt(p) != word2.charAt(i)) {
                p--;
            }
            if (p < 0) {
                break;
            }
            right[i] = p;
            p--;
        }
        boolean possible = true;
        for (int i = 0; i < m; i++) {
            if (right[i] == 0 && word1.charAt(0) != word2.charAt(i)) {
                possible = false;
                break;
            }
        }
        int[] ans = new int[m];
        int j = 0;
        boolean changed = false;
        for (int i = 0; i < n && j < m; i++) {
            // Exact match
            if (word1.charAt(i) == word2.charAt(j)) {
                ans[j] = i;
                j++;
            }
            // Use our one allowed mismatch
            else if (!changed) {
                // If this is the last character, we can always use the mismatch.
                if (j == m - 1) {
                    ans[j] = i;
                    j++;
                    changed = true;
                }
                // Otherwise, make this mismatch only if the rest can be matched after i.
                else if (right[j + 1] > i) {
                    ans[j] = i;
                    j++;
                    changed = true;
                }
            }
        }
        if (j != m) {
            return new int[0];
        }
        return ans;
    }
}