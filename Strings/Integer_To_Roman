class Solution {

    public String intToRoman(int num) {
        // Roman values descending order mein
        int[] values = {
            1000, 900, 500, 400,
            100, 90, 50, 40,
            10, 9, 5, 4, 1
        };
        //corresponding Roman symbol of each value
        String[] symbols = {
            "M", "CM", "D", "CD",
            "C", "XC", "L", "XL",
            "X", "IX", "V", "IV", "I"
        };
        StringBuilder ans = new StringBuilder();
        //check every roman val
        for (int i = 0; i < values.length; i++) {
            // Jab tak current value fit ho rahi hai
            while (num >= values[i]) {
                // Roman symbol answer me add karo
                ans.append(symbols[i]);
                // Number se value subtract kar do
                num -= values[i];
            }
        }
        return ans.toString();
    }
}