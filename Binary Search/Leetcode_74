class Solution {

    public boolean searchMatrix(int[][] matrix, int target) {

        int rows = matrix.length;
        int cols = matrix[0].length;

        // Flattened array ka low aur high
        int low = 0;
        int high = rows * cols - 1;

        while (low <= high){
            int mid = low + (high - low) / 2;

            //convert mid into row and col
            int row = mid / cols;
            int col = mid % cols;

            int value = matrix[row][col];
            if (value == target)
                return true;
            //agar current value chhoti hai then go right
            else if (value < target)
                low = mid + 1;
            //search left
            else
                high = mid - 1;
        }
        return false;
    }
}