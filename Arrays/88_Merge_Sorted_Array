class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int i = m-1 ; //last valid element of nums 1 (excluding extra 0s)
        int j = n-1 ; //last element of nums 2 
        int k = m+n-1 ; //the last index of nums 1 where we will insert the element

        while (i>= 0 && j>=0)
        {
            if(nums1[i] > nums2[j])
            {
                nums1[k]=nums1[i];
                i--;
            }
            else
            {
                nums1[k]=nums2[j];
            j--;
            }

        
        k--;
    }
        while (j>=0) //move remaining elements if any
        {
            nums1[k]= nums2[j];
            j--;
            k--;
        }
    }
}