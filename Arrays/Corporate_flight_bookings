class Solution {
    public int[] corpFlightBookings(int[][] bookings, int n) {

        //created a diff array
        int[] diff = new int[n];
        //process every booking 
        for (int[] booking : bookings) {
            // Booking details 
            int firstFlight = booking[0];
            int lastFlight = booking[1];
            int seats = booking[2];
            // Flights 1-indexed hain, array 0-indexed hai
            int l = firstFlight - 1;
            int r = lastFlight - 1;
            // l se seats add hona start honge
            diff[l] += seats;

            // r ke baad effect band karna hai
            if (r + 1 < n) {
                diff[r + 1] -= seats;
            }
        }
        // Prefix sum laga kar find out actual seats
        int[] ans = new int[n];
        // Current flight tak total seats
        int prefix = 0;
        for (int i = 0; i < n; i++) {
            // Diff array ko prefix sum me convert
            prefix += diff[i];

            // this is flight par total booked seats 
            ans[i] = prefix;
        }

        return ans;
    }
}