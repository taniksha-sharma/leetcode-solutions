class Solution {
    public int reverseBits(int n) {

        int ans = 0;

        // Integer = 32bits
        for (int i = 0; i < 32; i++) {

            // Last bit nikalo
            int bit = n & 1;

            //left shift ans
            ans = ans << 1;

            //add current bit
            ans = ans | bit;

            // Next bit par jaane ke liye unsigned right shift use karenge
            n = n >>> 1;
        }

        return ans;
    }
}