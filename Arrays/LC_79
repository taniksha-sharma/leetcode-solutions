class Solution {
    public boolean exist(char[][] board, String word) {
        int rows = board.length;
        int cols = board[0].length;
        // Har cell ko starting point maan ke check karenge
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                // Agar first character match karta hai
                if (board[i][j] == word.charAt(0)) {

                    if (dfs(board, word, i, j, 0))
                        return true;
                }
            }
        }
        return false;
    }
    public boolean dfs(char[][] board,
                       String word,
                       int row,
                       int col,
                       int index) {
        // Saare characters found
        if (index == word.length())
            return true;
        int rows = board.length;
        int cols = board[0].length;
        // Boundary + mismatch check
        if (row < 0 || col < 0 ||
            row >= rows || col >= cols ||
            board[row][col] != word.charAt(index))
            return false;
        // Current character save
        char temp = board[row][col];
        // Visited mark karne ke liye kisi special character se replace kar do
        board[row][col] = '#';
        boolean found =
                dfs(board, word, row + 1, col, index + 1) || // Down
                dfs(board, word, row - 1, col, index + 1) || // Up
                dfs(board, word, row, col + 1, index + 1) || // Right
                dfs(board, word, row, col - 1, index + 1);   // Left
        // Backtracking (original value wapas)
        board[row][col] = temp;
        return found;
    }
}