//prefix sum + difference array
class Solution {
    public boolean carPooling(int[][] trips, int capacity) {
        // Max location 1000 tak ja sakti hai
        int[] diff = new int[1001];
        // process trips
        for (int[] trip : trips) {
            int passengers = trip[0];
            int from = trip[1];
            int to = trip[2];
            // from location to pick passengers
            diff[from] += passengers;
            // to location par drop passengers
            diff[to] -= passengers;
        }

        // Current passengers in car
        int currentPassengers = 0;

        // Prefix sum laga kar har location par calc passengers count
        for (int i = 0; i < 1001; i++) {

            currentPassengers += diff[i];

            // Agar capacity exceed ho gayi to answer false
            if (currentPassengers > capacity) {
                return false;
            }
        }

        return true;
    }
}