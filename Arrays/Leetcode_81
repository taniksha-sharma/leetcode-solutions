class Solution { //binary search in a sorted array works if at least one half is strictly sorted , from that we decide whether to go left or right 
    public boolean search(int[] arr, int target) {
        int low = 0;
        int high = arr.length - 1;

        while(low <= high){  //if target is found
            int mid = low + (high - low)/2;
            if(arr[mid] == target){
                return true ;
            }
            if(arr[low] == arr[mid] && arr[mid] == arr[high]){ //if duplicates are found we shrink window
                low ++;
                high --;
                continue;
            }
            if(arr[low] <= arr[mid]){
            if(arr[low] <= target && target < arr[mid]){  //if left half is sorted & target lies in left half 
                    high = mid - 1;
            }
                else{
                    low= mid + 1;
                }
                }else{
                     if(arr[mid] < target && target <= arr[high]){ //if right half is sorted
                        low = mid + 1;
                    }else{
                        high = mid - 1;
                    }
                }
                }
                return false;
            }
        }
        
    