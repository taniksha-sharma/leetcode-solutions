class Solution {
    int count = 0;
    public int reversePairs(int[] nums) {
        mergeSort(nums, 0, nums.length - 1);
        return count;
    }
    private void mergeSort(int[] nums, int left, int right) {
        if (left >= right)
            return;

        int mid = left + (right - left) / 2;
        //sort left half
        mergeSort(nums, left, mid);
        //sort Right half 
        mergeSort(nums, mid + 1, right);
        // Reverse pairs count
        countPairs(nums, left, mid, right);
        //merge both sorted halves
        merge(nums, left, mid, right);
    }
    private void countPairs(int[] nums, int left, int mid, int right) {
        int j = mid + 1;
        for (int i = left; i <= mid; i++) {
            //jab tak condition satisfy ho rhi hai,move right pointer
            while (j <= right && (long) nums[i] > 2L * nums[j]) {
                j++;
            }
            //check the valid elemts at right
            count += j - (mid + 1);
        }
    }
    private void merge(int[] nums, int left, int mid, int right) {
        int[] temp = new int[right - left + 1];
        int i = left;
        int j = mid + 1;
        int k = 0;
        //merge both sorted arrays
        while (i <= mid && j <= right) {
            if (nums[i] <= nums[j]) {
                temp[k++] = nums[i++];
            } else {
                temp[k++] = nums[j++];
            }
        }
        //remaining elements at left
        while (i <= mid)
            temp[k++] = nums[i++];

        //remaining elements at right
        while (j <= right)
            temp[k++] = nums[j++];

        //copy back to org array
        for (int x = 0; x < temp.length; x++) {
            nums[left + x] = temp[x];
        }
    }
}