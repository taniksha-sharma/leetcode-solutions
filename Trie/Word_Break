import java.util.*;

class Solution {
    // Definition of a Trie Node
    static class TrieNode {
        TrieNode[] children = new TrieNode[26];
        boolean isEndOfWord = false;
    }

    // Function to insert a key into the Trie
    private void insert(TrieNode root, String key) {
        TrieNode curr = root;
        for (int i = 0; i < key.length(); i++) {
            int index = key.charAt(i) - 'a';
            if (curr.children[index] == null) {
                curr.children[index] = new TrieNode();
            }
            curr = curr.children[index];
        }
        curr.isEndOfWord = true;
    }

    public boolean wordBreak(String s, String[] dictionary) {
        int n = s.length();

        // Build the Trie from the dictionary
        TrieNode root = new TrieNode();
        for (String word : dictionary) {
            insert(root, word);
        }

        // dp[i] will store true if s[i...n-1] can be segmented using the dictionary
        boolean[] dp = new boolean[n + 1];
        dp[n] = true; // Base case: empty suffix is valid

        // Traverse backwards from the end of the string
        for (int i = n - 1; i >= 0; i--) {
            TrieNode curr = root;
            for (int j = i; j < n; j++) {
                int index = s.charAt(j) - 'a';

                // If character doesn't exist in Trie, no word starts with this path
                if (curr.children[index] == null) {
                    break;
                }

                curr = curr.children[index];

                // If a valid word ends at index j, check if the remaining substring s[j+1...] is valid
                if (curr.isEndOfWord && dp[j + 1]) {
                    dp[i] = true;
                    break;
                }
            }
        }

        return dp[0];
    }
}